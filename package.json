{
  "name": "bancada",
  "version": "0.2.0",
  "description": "A local-first study workbench: markdown lessons, your notes, and plugins for the subject you are learning",
  "keywords": [
    "study",
    "notes",
    "markdown",
    "plugins",
    "local-first"
  ],
  "homepage": "https://github.com/HenriqueArtur/bancada#readme",
  "bugs": {
    "url": "https://github.com/HenriqueArtur/bancada/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriqueArtur/bancada.git"
  },
  "license": "MIT",
  "author": "Henrique Artur <contato@henriqueartur.com>",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "marked": "16.4.1",
    "marked-highlight": "2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
